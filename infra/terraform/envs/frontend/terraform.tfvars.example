# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# api_origin_domain and amplify_app_id are NOT set here: scripts/deploy-frontend.sh
# looks both up on every run and passes them with -var.

expected_aws_account_id = "123456789012"
aws_region              = "us-west-2"
environment             = "dev"

repository_url = "https://github.com/your-github-user/your-repo"
branch_name    = "aws-deployment"
