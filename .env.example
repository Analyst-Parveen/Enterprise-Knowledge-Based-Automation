# Copy to .env and fill in. NEVER commit .env.
# Placeholder values only in this file - see .claude/rules/secrets-management.md
# In AWS, real values come from Secrets Manager: ekba/<env>/<component>/<name>
#
# Values marked [YOU MUST SET] have no safe default. Scripts refuse to run
# without them. Everything else has a working local default.

# ===========================================================================
# PROJECT / ENVIRONMENT
# ===========================================================================
ENVIRONMENT=dev
PROJECT_CODE=ekba
LOG_LEVEL=INFO

# ===========================================================================
# COST CONTROL - $20 HARD CEILING
# The whole architecture is built around this. See PROJECT.md section 16.
# ===========================================================================
# Total spend ceiling.
MAX_MONTHLY_SPEND_USD=20

# Spend is measured GROSS of credits (credits netted in would read $0 until they
# run out). deploy.sh refuses to deploy once gross usage since COST_GUARD_START
# reaches COST_GUARD_SHUTDOWN_USD - the same threshold at which the cost-guard
# Lambda (infra/terraform/envs/cost-guard) stops the environment.
COST_GUARD_START=2026-09-01
COST_GUARD_SHUTDOWN_USD=18

# AWS Budget created by Terraform, with alerts at 50/80/100%.
AWS_BUDGET_LIMIT_USD=20

# Per-user daily AI spend ceiling enforced in the application.
DAILY_COST_CEILING_USD=0.50

# Warn if a single demo session is projected to exceed this.
SESSION_COST_WARN_USD=1.00

# ===========================================================================
# AWS - SAFETY PREFLIGHT
# Lifecycle scripts REFUSE to touch AWS without these. This is what stops a
# deploy or destroy landing in the wrong account.
# ===========================================================================
EXPECTED_AWS_ACCOUNT_ID=<replace-me>          # [YOU MUST SET] your 12-digit account ID
EXPECTED_AWS_REGION=us-west-2                 # [YOU MUST SET] must match AWS_REGION
AWS_REGION=us-west-2                          # [YOU MUST SET]

# Lock the demo ALB to your own IP so nothing is publicly exposed.
# Find it with: curl -s https://checkip.amazonaws.com
# Read by the GitHub deploy workflow (as a repository variable). Local deploys
# read allowed_cidrs from infra/terraform/envs/dev/terraform.tfvars instead.
# Home IPs change: when yours does, update it or verify.sh cannot reach the ALB.
DEMO_ALLOWED_CIDR=<replace-me>/32             # [YOU MUST SET] e.g. 203.0.113.7/32

# ===========================================================================
# LOCAL DEVELOPMENT MODE  ($0 - no AWS account needed)
#
# Set both of these to run the entire stack offline for free during Phase 1-4.
#   AI_PROVIDER=local   deterministic stub embeddings + extractive answers
#   DEV_AUTH_ENABLED    accept locally-signed HS256 tokens instead of Cognito
#
# Both are hard-gated to ENVIRONMENT=dev and refuse to start anywhere else.
# Switch AI_PROVIDER to `bedrock` when you want real Bedrock calls.
# ===========================================================================
AI_PROVIDER=local
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=<replace-me-with-32+-random-chars>

# ===========================================================================
# DATASTORES
# Locally all three run as CONTAINERS (docker-compose.yml).
# On AWS, PostgreSQL is RDS (db.t4g.micro, private subnets) and Qdrant/Redis
# are sidecar containers. The AWS DATABASE_URL is NOT set here: the ECS task
# builds it from the RDS endpoint and the Secrets Manager password.
# ===========================================================================
POSTGRES_USER=ekba
POSTGRES_PASSWORD=<replace-me>                # [YOU MUST SET] local dev password
POSTGRES_DB=ekba
DATABASE_URL=postgresql+asyncpg://ekba:<replace-me>@localhost:5432/ekba

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                               # empty locally; set in AWS
QDRANT_COLLECTION=ekba_chunks

REDIS_URL=redis://localhost:6379/0

# ===========================================================================
# STORAGE - S3 is the only persistent data store in the demo
# ===========================================================================
S3_BUCKET=ekba-dev-documents                  # must be globally unique on AWS
S3_UPLOAD_MAX_BYTES=52428800                  # 50 MB upload cap
# Local dev points at MinIO from docker compose. LEAVE EMPTY on AWS.
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin                  # local MinIO only
AWS_SECRET_ACCESS_KEY=minioadmin              # local MinIO only

# ===========================================================================
# AUTHENTICATION - Amazon Cognito (free tier covers this project)
# ===========================================================================
COGNITO_USER_POOL_ID=<replace-me>
COGNITO_CLIENT_ID=<replace-me>
COGNITO_CLIENT_SECRET=<replace-me>
COGNITO_REGION=us-west-2

# ===========================================================================
# AI - AMAZON BEDROCK ONLY (chat AND embeddings)
#
# IMPORTANT FACTS:
#   * GPT-4 is NOT on Bedrock. Only OpenAI's OPEN-WEIGHT gpt-oss models are.
#   * gpt-oss models are TEXT-ONLY - vision must use Nova Lite.
#   * OpenAI embedding models are NOT on Bedrock - embeddings use Titan v2.
#   * Gemini 2.5 Flash is NOT on Bedrock (it is Google Vertex AI). Not used.
#
# Verify availability in YOUR region before relying on a model ID:
#   aws bedrock list-foundation-models --region $AWS_REGION \
#       --query 'modelSummaries[].modelId' --output table
# ===========================================================================
BEDROCK_REGION=us-west-2

# Chat - primary. OpenAI open-weight, text-only, limited regions.
BEDROCK_CHAT_PRIMARY_MODEL_ID=us.amazon.nova-lite-v1:0

# Chat - fallback. Cheaper and available in more regions.
BEDROCK_CHAT_FALLBACK_MODEL_ID=us.amazon.nova-micro-v1:0

# Vision / multimodal. Handles images, diagrams, tables AND video frames.
BEDROCK_VISION_MODEL_ID=us.amazon.nova-lite-v1:0

# Embeddings. Dimension MUST match the Qdrant collection - changing either
# one requires a new collection and a re-index. Never mix embedding models.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSION=1024

# Audio - speech to text for audio files, video tracks, and voice input
TRANSCRIBE_REGION=us-west-2

# ===========================================================================
# RAG / GUARDRAIL TUNING
# Changing any of these requires an evaluation run - see testing.md section 5.
# ===========================================================================
RETRIEVAL_TOP_K=8
RELEVANCE_THRESHOLD=0.35
MAX_OUTPUT_TOKENS=1024
MAX_INPUT_TOKENS=8192
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY=0.95

# ===========================================================================
# RATE LIMITS (per user per minute) - PROJECT.md section 9
# ===========================================================================
RATE_LIMIT_REQUESTS_PER_MIN=20
RATE_LIMIT_SERVER_REQUESTS_PER_MIN=10
RATE_LIMIT_UPLOADS_PER_MIN=5

# ===========================================================================
# SECURITY
# ===========================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# ===========================================================================
# OBSERVABILITY - optional locally, leave tracing off to avoid noise
# ===========================================================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ekba-dev
LANGSMITH_TRACING=false
CLOUDWATCH_LOG_RETENTION_DAYS=1

# ===========================================================================
# FRONTEND - NEXT_PUBLIC_* IS PUBLIC. Never put a secret here.
# ===========================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
